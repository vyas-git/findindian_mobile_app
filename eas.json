{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://nvksbmrjhwqgfcysqbcj.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISH_KEY": "sb_publishable_ilgrVCCUsHyGLr3-cqZEwA_Xuan2Ri4",
        "EXPO_PUBLIC_API_URL": "https://api.findindian.de",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://nvksbmrjhwqgfcysqbcj.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISH_KEY": "sb_publishable_ilgrVCCUsHyGLr3-cqZEwA_Xuan2Ri4",
