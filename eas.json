        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote",
        "simulator": false
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
