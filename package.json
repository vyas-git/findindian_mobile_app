{
  "name": "findindian-mobile",
  "version": "1.0.12",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "@supabase/supabase-js": "^2.33.0",
    "dotenv": "^16.3.1",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^1.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "prepare-env": "node scripts/apply-dotenv.js",
    "start": "npm run prepare-env && expo start --lan",
    "start:lan": "npm run prepare-env && expo start --lan --clear",
    "start:tunnel": "npm run prepare-env && EXPO_UNSTABLE_TUNNEL_V2=1 expo start --tunnel --clear",
    "start:android": "npm run prepare-env && expo start --android --lan",
    "build:dev:android": "npx eas-cli build --profile development --platform android",
    "build:dev:android:ci": "npx eas-cli build --profile development --platform android --non-interactive",
    "build:dev:ios": "npx eas-cli build --profile development --platform ios --non-interactive",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios --no-wait",
    "android": "npm run prepare-env && expo start --android",
    "ios": "npm run prepare-env && expo start --ios",
    "web": "npm run prepare-env && expo start --web",
    "build:prod:android": "npx eas-cli build --profile production --platform android",
    "build:prod:android:ci": "npx eas-cli build --profile production --platform android --non-interactive",
    "update:preview": "EXPO_PUBLIC_API_URL=https://api.findindian.de npx eas-cli update --channel preview --message",
    "update:production": "EXPO_PUBLIC_API_URL=https://api.findindian.de npx eas-cli update --channel production --message",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:playstore": "node scripts/generate-playstore.mjs",
    "screenshots:store": "node scripts/generate-store-screenshots.mjs",
    "screenshots:store:puppeteer": "SCREENSHOTS_SOURCE=puppeteer node scripts/generate-store-screenshots.mjs",
    "screenshots:chatgpt:prepare": "node scripts/prepare-chatgpt-screenshots.mjs",
    "screenshots:appstore:chatgpt-enhanced": "node scripts/generate-appstore-chatgpt-enhanced.mjs",
    "screenshots:calibrate": "node scripts/calibrate-device-overlays.mjs"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "babel-preset-expo": "~57.0.0",
    "eas-cli": "^16.0.0",
    "puppeteer": "^23.11.1",
    "sharp": "^0.33.5"
  }
}
